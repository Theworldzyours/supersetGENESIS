# GENESIS Destatis API Configuration
# Copy this file to .env.genesis and configure with your credentials

# GENESIS API Credentials
# Default: GAST/GAST (public access with limited features)
# For full access, register at https://www-genesis.destatis.de
GENESIS_USERNAME=GAST
GENESIS_PASSWORD=GAST

# Database connection for storing GENESIS data
# This should point to a dedicated database for GENESIS data
# Format: postgresql://username:password@host:port/database
# Example: postgresql://genesis:genesis_password@localhost:5433/genesis
SUPERSET_GENESIS_DB_URI=postgresql://genesis:genesis@genesis-db:5432/genesis
